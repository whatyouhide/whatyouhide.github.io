---
import NeatAnnotation from "../neat-annotation.astro";
---

<section
    class="gsx-key-passage"
    aria-label="Key passage about minimum and maximum demand"
>
    <NeatAnnotation
        class="gsx-key-passage__note"
        note="// the whole trick"
        direction="e"
        mark={false}
        aria-hidden="true"
    />

    <svg
        class="gsx-key-passage__brace"
        viewBox="0 0 46 400"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <path d="M42 4 C21 5, 18 23, 18 48 L18 166 C18 187, 10 197, 3 200 C10 203, 18 213, 18 234 L18 352 C18 377, 21 395, 42 396" />
    </svg>

    <div class="gsx-key-passage__content">
        <slot />
    </div>
</section>

---
const producers = Array.from({ length: 4 });
const processors = Array.from({ length: 8 });
const batchers = [
    { key: ":default", code: "D" },
    { key: ":priority", code: "P" },
];
const batchProcessors = Array.from({ length: 4 });
---

<broadway-scroll-explainer
    data-producer-count="2"
    data-processor-count="4"
    data-batcher-key-count="2"
    data-batch-processor-count="2"
>
    <button class="bvx-reading-toggle" type="button" data-reading-toggle aria-pressed="false">Read without scroll effects</button>
    <div class="bvx-scroll">
        <div class="bvx-story" aria-label="Broadway pipeline walkthrough">
            <section
                id="broadway-start"
                class="bvx-step is-active"
                data-step="0"
            >
                <div class="bvx-copy-positioner">
                    <div class="bvx-copy">
                        <slot name="source" />
                    </div>
                </div>
            </section>

            <section class="bvx-step" data-step="1">
                <div class="bvx-copy-positioner">
                    <div class="bvx-copy">
                        <slot name="producers" />
                        <label class="bvx-control">
                            <span>
                                Producer processes
                                <output data-producer-output>2</output>
                            </span>
                            <input
                                type="range"
                                min="1"
                                max="4"
                                value="2"
                                step="1"
                                data-producer-input
                                aria-label="Number of producer processes"
                            />
                            <span class="bvx-range-labels" aria-hidden="true"
                                ><i>1</i><i>4</i></span
                            >
                        </label>
                    </div>
                </div>
            </section>

            <section class="bvx-step" data-step="2">
                <div class="bvx-copy-positioner">
                    <div class="bvx-copy">
                        <slot name="processors" />
                        <label class="bvx-control">
                            <span>
                                Processor processes
                                <output data-processor-output>4</output>
                            </span>
                            <input
                                type="range"
                                min="1"
                                max="8"
                                value="4"
                                step="1"
                                data-processor-input
                                aria-label="Number of processor processes"
                            />
                            <span class="bvx-range-labels" aria-hidden="true"
                                ><i>1</i><i>8</i></span
                            >
                        </label>
                    </div>
                </div>
            </section>

            <section class="bvx-step" data-step="3">
                <div class="bvx-copy-positioner">
                    <div class="bvx-copy">
                        <slot name="batchers" />
                        <label class="bvx-control">
                            <span>
                                Configured batcher keys
                                <output data-batcher-key-output>2</output>
                            </span>
                            <input
                                type="range"
                                min="1"
                                max="2"
                                value="2"
                                step="1"
                                data-batcher-key-input
                                aria-label="Number of configured batcher keys"
                            />
                            <span class="bvx-range-labels" aria-hidden="true"
                                ><i>1</i><i>2</i></span
                            >
                        </label>
                    </div>
                </div>
            </section>

            <section class="bvx-step" data-step="4">
                <div class="bvx-copy-positioner">
                    <div class="bvx-copy">
                        <slot name="batch-processors" />
                        <label class="bvx-control">
                            <span>
                                Batch processor concurrency
                                <output data-batch-processor-output>2</output>
                            </span>
                            <input
                                type="range"
                                min="1"
                                max="4"
                                value="2"
                                step="1"
                                data-batch-processor-input
                                aria-label="Batch processor concurrency per batcher"
                            />
                            <span class="bvx-range-labels" aria-hidden="true"
                                ><i>1</i><i>4</i></span
                            >
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <div class="bvx-stage-shell">
            <div class="bvx-stage" data-stage>
                <div
                    class="bvx-stage-grid"
                    role="img"
                    aria-label="Messages move from a source through Broadway producers, processors, batchers, and batch processors"
                >
                    <svg class="bvx-wires" data-wires aria-hidden="true">
                        <g data-source-wires>
                            {
                                producers.map((_, index) => (
                                    <g
                                        class="bvx-wire"
                                        data-source-wire={index}
                                    >
                                        <path class="bvx-wire-base" />
                                    </g>
                                ))
                            }
                        </g>
                        <g data-processor-wires>
                            {
                                producers.flatMap((_, producerIndex) => processors.map((_, index) => (
                                    <g class="bvx-wire" data-processor-wire={index} data-producer-index={producerIndex}>
                                        <path class="bvx-wire-base" />
                                    </g>
                                )))
                            }
                        </g>
                        <g data-batcher-wires>
                            {
                                processors.flatMap((_, index) => batchers.map((_, batcherIndex) => (
                                    <g class="bvx-wire" data-batcher-wire={index} data-batcher-index={batcherIndex}>
                                        <path class="bvx-wire-base" />
                                    </g>
                                )))
                            }
                        </g>
                        <g data-batch-processor-wires>
                            {
                                batchers.flatMap((batcher, batcherIndex) =>
                                    batchProcessors.map((_, index) => (
                                        <g
                                            class="bvx-wire"
                                            data-batch-processor-wire
                                            data-batcher-index={batcherIndex}
                                            data-worker-index={index}
                                        >
                                            <path class="bvx-wire-base" />
                                        </g>
                                    )),
                                )
                            }
                        </g>
                    </svg>

                    <section
                        class="bvx-layer bvx-layer--source"
                        aria-label="Message source"
                    >
                        <div class="bvx-source">

                            <div class="bvx-source-queue" data-source-node>
                                <strong>Source</strong>
                                <svg
                                    class="bvx-queue-cylinder"
                                    viewBox="0 0 260 112"
                                    aria-hidden="true"
                                >
                                    <path
                                        class="bvx-cylinder-body"
                                        d="M30 14H226V98H30Z"
                                    />
                                    <ellipse
                                        class="bvx-cylinder-rear"
                                        cx="30"
                                        cy="56"
                                        rx="20"
                                        ry="42"
                                    />
                                    <ellipse
                                        class="bvx-cylinder-front"
                                        cx="226"
                                        cy="56"
                                        rx="20"
                                        ry="42"
                                    />
                                    <path
                                        class="bvx-cylinder-edge"
                                        d="M30 14H226M30 98H226"
                                    />
                                    <ellipse
                                        class="bvx-cylinder-rim"
                                        cx="30"
                                        cy="56"
                                        rx="14"
                                        ry="34"
                                    />
                                    <ellipse
                                        class="bvx-cylinder-rim"
                                        cx="226"
                                        cy="56"
                                        rx="14"
                                        ry="34"
                                    />
                                    <path
                                        class="bvx-cylinder-rail"
                                        d="M56 25H200M56 87H200"
                                    />
                                    <path
                                        class="bvx-cylinder-outlet"
                                        d="M246 49H254V63H246"
                                    />
                                </svg>
                            </div>
                        </div>
                    </section>

                    <section
                        class="bvx-layer bvx-layer--producers"
                        aria-label="Broadway producers"
                    >
                        <span class="bvx-layer-label">Producers</span>
                        <div class="bvx-node-stack" data-producer-stack>
                            {
                                producers.map((_, index) => (
                                    <div
                                        class="bvx-worker"
                                        data-producer={index}
                                        aria-hidden={
                                            index >= 2 ? "true" : "false"
                                        }
                                    >
                                        <span class="bvx-worker-index">
                                            P
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        <span>
                                            <small>producer</small>
                                            <strong>receive</strong>
                                        </span>
                                        <i
                                            class="bvx-worker-status"
                                            aria-hidden="true"
                                        />
                                    </div>
                                ))
                            }
                        </div>
                        <span class="bvx-layer-note">pull messages in</span>
                    </section>

                    <section
                        class="bvx-layer bvx-layer--processors"
                        aria-label="Broadway processors"
                    >
                        <span class="bvx-layer-label">Processors</span>
                        <div class="bvx-node-stack" data-processor-stack>
                            {
                                processors.map((_, index) => (
                                    <div
                                        class="bvx-worker bvx-worker--processor"
                                        data-processor={index}
                                        aria-hidden={
                                            index >= 4 ? "true" : "false"
                                        }
                                    >
                                        <span class="bvx-worker-index">
                                            W
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        <span>
                                            <small>processor</small>
                                            <strong>handle_message/3</strong>
                                        </span>
                                        <i
                                            class="bvx-worker-status"
                                            aria-hidden="true"
                                        />
                                    </div>
                                ))
                            }
                        </div>
                        <span class="bvx-layer-note"
                            >run work at the same time</span
                        >
                    </section>

                    <section
                        class="bvx-layer bvx-layer--batchers"
                        aria-label="Broadway batchers"
                    >
                        <span class="bvx-layer-label">Batchers</span>
                        <div class="bvx-node-stack" data-batcher-stack>
                            {
                                batchers.map((batcher, index) => (
                                    <div
                                        class="bvx-worker bvx-worker--batcher"
                                        data-batcher={index}
                                        aria-hidden={
                                            index >= 2 ? "true" : "false"
                                        }
                                    >
                                        <span class="bvx-worker-index">B</span>
                                        <span>
                                            <small>batcher</small>
                                            <strong>{batcher.key}</strong>
                                        </span>
                                        <i
                                            class="bvx-worker-status"
                                            aria-hidden="true"
                                        />
                                    </div>
                                ))
                            }
                        </div>
                        <span class="bvx-layer-note"
                            >form batches by message batch key</span
                        >
                    </section>

                    <section
                        class="bvx-layer bvx-layer--batch-processors"
                        aria-label="Broadway batch processors"
                    >
                        <span class="bvx-layer-label">Batch processors</span>
                        <div class="bvx-batch-processor-groups">
                            {
                                batchers.map((batcher, batcherIndex) => (
                                    <div
                                        class="bvx-batch-processor-group"
                                        data-batch-processor-group={batcherIndex}
                                    >
                                        <span class="bvx-batch-group-label">
                                            {batcher.key}
                                        </span>
                                        <div class="bvx-node-stack">
                                            {batchProcessors.map((_, index) => (
                                                <div
                                                    class="bvx-worker bvx-worker--batch-processor"
                                                    data-batch-processor
                                                    data-batcher-index={
                                                        batcherIndex
                                                    }
                                                    data-worker-index={index}
                                                    aria-hidden={
                                                        index >= 2
                                                            ? "true"
                                                            : "false"
                                                    }
                                                >
                                                    <span class="bvx-worker-index">
                                                        {batcher.code}
                                                        {String(
                                                            index + 1,
                                                        ).padStart(2, "0")}
                                                    </span>
                                                    <span>
                                                        <small>
                                                            batch processor
                                                        </small>
                                                        <strong>
                                                            handle_batch/4
                                                        </strong>
                                                    </span>
                                                    <i
                                                        class="bvx-worker-status"
                                                        aria-hidden="true"
                                                    />
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <span class="bvx-layer-note"
                            >run handle_batch/4 concurrently</span
                        >
                    </section>
                </div>

                <div class="bvx-flow-controls" aria-label="Pipeline animation controls">
                    <p data-flow-action>Messages arrive at the source.</p>
                    <div class="bvx-flow-buttons">
                        <button type="button" data-flow-play>Pause flow</button>
                        <button type="button" data-flow-next aria-label="Next pipeline event">Next event</button>
                        <button type="button" data-flow-replay>Replay flow</button>
                    </div>
                    <span class="bvx-flow-context"><span data-layer-status>source</span> · example with 10 messages<span class="bvx-flow-batch-settings"> · batch size 3 · timeout 4.2 s</span></span>
                    <span class="bvx-sr-only" data-flow-announcement role="status" aria-live="polite"></span>
                </div>
            </div>
        </div>
    </div>
</broadway-scroll-explainer>

<script>
    import { BroadwayPipelineFlow } from "./broadwayPipelineFlow";
    class BroadwayScrollExplainer extends HTMLElement {
        pipelineFlow?: BroadwayPipelineFlow;
        flowChapter = 0;
        producerCount = 2;
        processorCount = 4;
        batcherKeyCount = 2;
        batchProcessorCount = 2;
        frame = 0;
        scrollFrame = 0;
        resizeObserver?: ResizeObserver;
        reduceMotion = false;
        readingView = false;
        inlineLoaded = false;
        readingToggle?: HTMLButtonElement | null;
        motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
        compactPreference = window.matchMedia("(max-width: 1200px), (max-height: 800px)");
        stage?: HTMLElement | null;
        stageGrid?: HTMLElement | null;
        scrollContainer?: HTMLElement | null;
        sourceNode?: HTMLElement | null;
        producerNodes!: HTMLElement[];
        processorNodes!: HTMLElement[];
        batcherNodes!: HTMLElement[];
        batchProcessorNodes!: HTMLElement[];
        sourceWires!: SVGGElement[];
        processorWires!: SVGGElement[];
        batcherWires!: SVGGElement[];
        batchProcessorWires!: SVGGElement[];
        steps!: HTMLElement[];
        copyPositioners!: HTMLElement[];
        producerInput?: HTMLInputElement | null;
        processorInput?: HTMLInputElement | null;
        batcherKeyInput?: HTMLInputElement | null;
        batchProcessorInput?: HTMLInputElement | null;
        status?: HTMLElement | null;
        producerLayer?: HTMLElement | null;
        processorLayer?: HTMLElement | null;
        batcherLayer?: HTMLElement | null;
        batchProcessorLayer?: HTMLElement | null;

        connectedCallback() {
            this.producerCount = Number(this.dataset.producerCount) || 2;
            this.processorCount = Number(this.dataset.processorCount) || 4;
            this.batcherKeyCount = Number(this.dataset.batcherKeyCount) || 2;
            this.batchProcessorCount =
                Number(this.dataset.batchProcessorCount) || 2;
            this.stage = this.querySelector<HTMLElement>("[data-stage]");
            this.stageGrid =
                this.querySelector<HTMLElement>(".bvx-stage-grid");
            this.scrollContainer =
                this.querySelector<HTMLElement>(".bvx-scroll");
            this.sourceNode =
                this.querySelector<HTMLElement>("[data-source-node]");
            this.producerNodes = [
                ...this.querySelectorAll<HTMLElement>("[data-producer]"),
            ];
            this.processorNodes = [
                ...this.querySelectorAll<HTMLElement>("[data-processor]"),
            ];
            this.batcherNodes = [
                ...this.querySelectorAll<HTMLElement>("[data-batcher]"),
            ];
            this.batchProcessorNodes = [
                ...this.querySelectorAll<HTMLElement>(
                    "[data-batch-processor]",
                ),
            ];
            this.sourceWires = [
                ...this.querySelectorAll<SVGGElement>("[data-source-wire]"),
            ];
            this.processorWires = [
                ...this.querySelectorAll<SVGGElement>("[data-processor-wire]"),
            ];
            this.batcherWires = [
                ...this.querySelectorAll<SVGGElement>("[data-batcher-wire]"),
            ];
            this.batchProcessorWires = [
                ...this.querySelectorAll<SVGGElement>(
                    "[data-batch-processor-wire]",
                ),
            ];
            this.steps = [...this.querySelectorAll<HTMLElement>("[data-step]")];
            this.copyPositioners = [
                ...this.querySelectorAll<HTMLElement>(
                    ".bvx-copy-positioner",
                ),
            ];
            this.producerInput = this.querySelector<HTMLInputElement>(
                "[data-producer-input]",
            );
            this.processorInput = this.querySelector<HTMLInputElement>(
                "[data-processor-input]",
            );
            this.batcherKeyInput = this.querySelector<HTMLInputElement>(
                "[data-batcher-key-input]",
            );
            this.batchProcessorInput = this.querySelector<HTMLInputElement>(
                "[data-batch-processor-input]",
            );
            this.status = this.querySelector<HTMLElement>(
                "[data-layer-status]",
            );
            this.producerLayer = this.querySelector<HTMLElement>(
                ".bvx-layer--producers",
            );
            this.processorLayer = this.querySelector<HTMLElement>(
                ".bvx-layer--processors",
            );
            this.batcherLayer = this.querySelector<HTMLElement>(
                ".bvx-layer--batchers",
            );
            this.batchProcessorLayer = this.querySelector<HTMLElement>(
                ".bvx-layer--batch-processors",
            );
            this.reduceMotion = this.motionPreference.matches;
            this.motionPreference.addEventListener("change", this.onPreferenceChange);
            this.compactPreference.addEventListener("change", this.onPreferenceChange);
            this.dataset.ready = "true";
            this.readingToggle = this.querySelector("[data-reading-toggle]");
            this.readingToggle?.addEventListener("click", this.toggleReadingView);

            this.producerInput?.addEventListener("input", this.onProducerInput);
            this.processorInput?.addEventListener(
                "input",
                this.onProcessorInput,
            );
            this.batcherKeyInput?.addEventListener(
                "input",
                this.onBatcherKeyInput,
            );
            this.batchProcessorInput?.addEventListener(
                "input",
                this.onBatchProcessorInput,
            );
            window.addEventListener("scroll", this.onScroll, { passive: true });
            window.addEventListener("resize", this.onResize, { passive: true });

            this.resizeObserver = new ResizeObserver(this.queueMeasure);
            if (this.stage) this.resizeObserver.observe(this.stage);

            this.pipelineFlow = new BroadwayPipelineFlow(this, this.flowOptions());
            this.updateWorkers();
            this.queueMeasure();
            document.fonts.ready.then(() => { if (this.isConnected) this.queueMeasure(); });
            this.onScroll();
        }

        disconnectedCallback() {
            this.pipelineFlow?.destroy();
            cancelAnimationFrame(this.frame);
            cancelAnimationFrame(this.scrollFrame);
            this.resizeObserver?.disconnect();
            this.producerInput?.removeEventListener(
                "input",
                this.onProducerInput,
            );
            this.processorInput?.removeEventListener(
                "input",
                this.onProcessorInput,
            );
            this.batcherKeyInput?.removeEventListener(
                "input",
                this.onBatcherKeyInput,
            );
            this.batchProcessorInput?.removeEventListener(
                "input",
                this.onBatchProcessorInput,
            );
            this.readingToggle?.removeEventListener("click", this.toggleReadingView);
            this.motionPreference.removeEventListener("change", this.onPreferenceChange);
            this.compactPreference.removeEventListener("change", this.onPreferenceChange);
            window.removeEventListener("scroll", this.onScroll);
            window.removeEventListener("resize", this.onResize);
        }

        onProducerInput = (event: Event) => {
            this.producerCount = Number(
                (event.currentTarget as HTMLInputElement).value,
            );
            this.dataset.producerCount = String(this.producerCount);
            const output = this.querySelector<HTMLOutputElement>(
                "[data-producer-output]",
            );
            if (output) output.value = String(this.producerCount);
            this.updateWorkers();
        };

        onProcessorInput = (event: Event) => {
            this.processorCount = Number(
                (event.currentTarget as HTMLInputElement).value,
            );
            this.dataset.processorCount = String(this.processorCount);
            const output = this.querySelector<HTMLOutputElement>(
                "[data-processor-output]",
            );
            if (output) output.value = String(this.processorCount);
            this.updateWorkers();
        };

        onBatcherKeyInput = (event: Event) => {
            this.batcherKeyCount = Number(
                (event.currentTarget as HTMLInputElement).value,
            );
            this.dataset.batcherKeyCount = String(this.batcherKeyCount);
            const output = this.querySelector<HTMLOutputElement>(
                "[data-batcher-key-output]",
            );
            if (output) output.value = String(this.batcherKeyCount);
            this.updateWorkers();
        };

        onBatchProcessorInput = (event: Event) => {
            this.batchProcessorCount = Number(
                (event.currentTarget as HTMLInputElement).value,
            );
            this.dataset.batchProcessorCount = String(
                this.batchProcessorCount,
            );
            const output = this.querySelector<HTMLOutputElement>(
                "[data-batch-processor-output]",
            );
            if (output) output.value = String(this.batchProcessorCount);
            this.updateWorkers();
        };

        updateWorkers() {
            this.pipelineFlow?.configure(this.flowOptions());
            this.producerNodes?.forEach((node, index) => {
                const active = index < this.producerCount;
                node.classList.toggle("is-active", active);
                node.setAttribute("aria-hidden", String(!active));
            });
            this.processorNodes?.forEach((node, index) => {
                const active = index < this.processorCount;
                node.classList.toggle("is-active", active);
                node.setAttribute("aria-hidden", String(!active));
            });
            this.batcherNodes?.forEach((node, index) => {
                const active = index < this.batcherKeyCount;
                node.classList.toggle("is-active", active);
                node.setAttribute("aria-hidden", String(!active));
            });
            this.batchProcessorNodes?.forEach((node) => {
                const batcherIndex = Number(node.dataset.batcherIndex);
                const workerIndex = Number(node.dataset.workerIndex);
                const active =
                    batcherIndex < this.batcherKeyCount &&
                    workerIndex < this.batchProcessorCount;
                node.classList.toggle("is-active", active);
                node.setAttribute("aria-hidden", String(!active));
            });
            this.querySelectorAll<HTMLElement>(
                "[data-batch-processor-group]",
            ).forEach((group) => {
                const active =
                    Number(group.dataset.batchProcessorGroup) <
                    this.batcherKeyCount;
                group.classList.toggle("is-active", active);
                group.setAttribute("aria-hidden", String(!active));
            });
            this.queueMeasure();
        }

        flowOptions() {
            return {chapter: this.flowChapter, producers: this.producerCount, processors: this.processorCount, batchers: this.batcherKeyCount, workers: this.batchProcessorCount};
        }

        setFlowChapter(chapter: number) {
            this.flowChapter = chapter;
            if (this.dataset.flowChapter !== String(chapter)) this.dataset.flowChapter = String(chapter);
            this.pipelineFlow?.configure(this.flowOptions());
        }

        toggleReadingView = () => {
            this.readingView = !this.readingView;
            this.readingToggle?.setAttribute("aria-pressed", String(this.readingView));
            this.queueMeasure();
        };

        onPreferenceChange = () => {
            this.reduceMotion = this.motionPreference.matches;
            this.queueMeasure();
        };

        onResize = () => this.queueMeasure();

        queueMeasure = () => {
            cancelAnimationFrame(this.frame);
            this.frame = requestAnimationFrame(() => {
                this.renderScroll();
                this.measureWires();
                this.pipelineFlow?.measure();
            });
        };

        onScroll = () => {
            cancelAnimationFrame(this.scrollFrame);
            this.scrollFrame = requestAnimationFrame(() => this.renderScroll());
        };

        renderScroll() {
            // Small screens and reduced motion use normal document flow.
            const staticLayout = this.readingView || this.reduceMotion || this.compactPreference.matches;
            if (this.dataset.static !== String(staticLayout)) {
                this.dataset.static = String(staticLayout);
                this.dispatchEvent(new Event("broadway-layout"));
                this.pipelineFlow?.sync();
            }
            if (staticLayout && !this.inlineLoaded) {
                this.inlineLoaded = true;
                import("./broadwayInlineDiagram");
            }
            if (staticLayout) {
                this.steps.forEach(step => {
                    step.classList.remove("is-scrubbed");
                    step.classList.add("is-active", "is-interactive");
                    const copy = step.querySelector<HTMLElement>(".bvx-copy");
                    copy?.removeAttribute("style");
                    copy?.removeAttribute("inert");
                    copy?.removeAttribute("aria-hidden");
                });
                this.copyPositioners.forEach(node => node.classList.remove("is-pinned"));
                this.stageGrid?.style.removeProperty("transform");
                return;
            }
            const viewportCenter = window.innerHeight / 2;
            const stepRects = this.steps.map((step) =>
                step.getBoundingClientRect(),
            );
            const scrollRect = this.scrollContainer?.getBoundingClientRect();
            const stepCenters = stepRects.map(
                (rect) => rect.top + rect.height / 2,
            );
            const activeStep = stepCenters.reduce(
                (closest, center, index) =>
                    Math.abs(center - viewportCenter) <
                    Math.abs(stepCenters[closest] - viewportCenter)
                        ? index
                        : closest,
                0,
            );
            const segmentProgress = (fromIndex: number, toIndex: number) => {
                const from = stepCenters[fromIndex] ?? viewportCenter;
                const to = stepCenters[toIndex] ?? viewportCenter;
                return this.clamp(
                    (viewportCenter - from) / Math.max(1, to - from),
                );
            };
            const phase = (value: number, start: number, end: number) =>
                this.clamp((value - start) / (end - start));
            const quadratic = (
                start: number,
                control: number,
                end: number,
                progress: number,
            ) => {
                const inverse = 1 - progress;
                return (
                    inverse * inverse * start +
                    2 * inverse * progress * control +
                    progress * progress * end
                );
            };
            const reveal = (index: number) => {
                if (this.reduceMotion) return Number(activeStep >= index);
                const center = stepCenters[index] ?? window.innerHeight * 2;
                return this.clamp(
                    (window.innerHeight * 1.15 - center) /
                        (window.innerHeight * 0.65),
                );
            };
            const producerProgress = reveal(1);
            const processorProgress = reveal(2);
            const batcherTransition = this.reduceMotion
                ? Number(activeStep >= 3)
                : segmentProgress(2, 3);
            const batchProcessorTransition = this.reduceMotion
                ? Number(activeStep >= 4)
                : segmentProgress(3, 4);
            const batcherProgress = phase(batcherTransition, 0.24, 0.5);
            const batchProcessorProgress = phase(
                batchProcessorTransition,
                0.55,
                0.85,
            );
            this.setFlowChapter(batchProcessorProgress >= 0.95 ? 4 : batcherProgress >= 0.95 ? 3 : processorProgress >= 0.95 ? 2 : producerProgress >= 0.95 ? 1 : 0);
            const stageStartX = Math.min(
                544,
                Math.max(488, window.innerWidth * 0.36),
            );
            const stageEndY = Math.min(
                145,
                Math.max(96, window.innerHeight * 0.145),
            );
            const compactLayout = window.innerWidth <= 900;
            const graphDrop = phase(batcherTransition, 0.08, 0.24);
            const graphExpand = phase(batcherTransition, 0.18, 0.5);
            const stageX = compactLayout
                ? 0
                : stageStartX * (1 - graphExpand);
            const stageY = compactLayout ? 0 : stageEndY * graphDrop;
            const lateSequenceStarted = batcherTransition > 0;
            const exitProgress = scrollRect
                ? phase(
                      window.innerHeight - scrollRect.bottom,
                      0,
                      window.innerHeight * 0.25,
                  )
                : 0;
            const pinLateCards =
                !compactLayout &&
                lateSequenceStarted &&
                exitProgress < 1;
            const processorCopy =
                this.steps[2]?.querySelector<HTMLElement>(".bvx-copy");
            const batcherCopy =
                this.steps[3]?.querySelector<HTMLElement>(".bvx-copy");
            const batchProcessorCopy =
                this.steps[4]?.querySelector<HTMLElement>(".bvx-copy");
            const cardHandoff = phase(
                batchProcessorTransition,
                0.1,
                0.9,
            );
            const useCardPaths = !compactLayout && !this.reduceMotion;

            if (this.stageGrid) {
                this.stageGrid.style.transform =
                    `translate3d(${stageX}px, ${stageY}px, 0)`;
            }
            this.copyPositioners.forEach((positioner, index) =>
                positioner.classList.toggle(
                    "is-pinned",
                    pinLateCards && index >= 3,
                ),
            );
            let processorOpacity = 0;
            let batcherOpacity = 0;
            let batchProcessorOpacity = 0;

            if (lateSequenceStarted) {
                this.steps.slice(2, 5).forEach((step) =>
                    step.classList.add("is-scrubbed"),
                );
                const processorExit = phase(
                    batcherTransition,
                    0.2,
                    0.42,
                );
                processorOpacity = 1 - processorExit;
                const batcherEntrance = phase(
                    batcherTransition,
                    0.22,
                    0.38,
                );
                const batcherExit = useCardPaths
                    ? phase(cardHandoff, 0.92, 1)
                    : phase(batchProcessorTransition, 0.35, 0.48);
                const batchProcessorEntrance = useCardPaths
                    ? phase(cardHandoff, 0.02, 0.08)
                    : phase(batchProcessorTransition, 0.52, 0.65);
                batcherOpacity = batcherEntrance * (1 - batcherExit);
                batchProcessorOpacity =
                    batchProcessorEntrance *
                    (1 - exitProgress);
                const batcherX = useCardPaths
                    ? quadratic(
                          48 * (1 - batcherEntrance),
                          -window.innerWidth * 0.24,
                          -window.innerWidth * 0.9,
                          cardHandoff,
                      )
                    : 0;
                const batcherY = useCardPaths
                    ? 24 * (1 - batcherEntrance)
                    : -12 * batcherExit;
                const batchProcessorX = useCardPaths
                    ? quadratic(
                          window.innerWidth * 0.9,
                          window.innerWidth * 0.3,
                          0,
                          cardHandoff,
                      )
                    : 0;
                const batchProcessorY = useCardPaths
                    ? 0
                    : 12 * (1 - batchProcessorOpacity);

                if (processorCopy) {
                    processorCopy.style.opacity = String(processorOpacity);
                    processorCopy.style.transform =
                        `translate3d(${-window.innerWidth * 0.42 * processorExit}px, ${-24 * processorExit}px, 0) scale(1)`;
                }
                if (batcherCopy) {
                    batcherCopy.style.opacity = String(batcherOpacity);
                    batcherCopy.style.transform =
                        `translate3d(${batcherX}px, ${batcherY}px, 0)`;
                }
                if (batchProcessorCopy) {
                    batchProcessorCopy.style.opacity = String(
                        batchProcessorOpacity,
                    );
                    batchProcessorCopy.style.transform =
                        `translate3d(${batchProcessorX}px, ${batchProcessorY}px, 0)`;
                }
            } else {
                this.steps.slice(2, 5).forEach((step) =>
                    step.classList.remove("is-scrubbed"),
                );
                [processorCopy, batcherCopy, batchProcessorCopy].forEach(
                    (copy) => {
                        copy?.style.removeProperty("opacity");
                        copy?.style.removeProperty("transform");
                    },
                );
            }

            if (this.producerLayer)
                this.producerLayer.style.opacity = String(
                    this.clamp(producerProgress * 1.7),
                );
            if (this.processorLayer)
                this.processorLayer.style.opacity = String(
                    this.clamp(processorProgress * 1.7),
                );
            if (this.batcherLayer)
                this.batcherLayer.style.opacity = String(batcherProgress);
            if (this.batchProcessorLayer)
                this.batchProcessorLayer.style.opacity = String(
                    batchProcessorProgress,
                );

            this.sourceWires?.forEach((wire, index) => {
                this.renderWire(
                    wire,
                    index < this.producerCount,
                    producerProgress,
                );
            });
            this.processorWires?.forEach((wire) => {
                this.renderWire(
                    wire,
                    Number(wire.dataset.processorWire) < this.processorCount && Number(wire.dataset.producerIndex) < this.producerCount,
                    processorProgress,
                );
            });
            this.batcherWires?.forEach((wire) => {
                this.renderWire(
                    wire,
                    Number(wire.dataset.batcherWire) < this.processorCount && Number(wire.dataset.batcherIndex) < this.batcherKeyCount,
                    batcherProgress,
                );
            });
            this.batchProcessorWires?.forEach((wire) => {
                const batcherIndex = Number(wire.dataset.batcherIndex);
                const workerIndex = Number(wire.dataset.workerIndex);
                this.renderWire(
                    wire,
                    batcherIndex < this.batcherKeyCount &&
                        workerIndex < this.batchProcessorCount,
                    batchProcessorProgress,
                );
            });

            const targetOpacities = this.steps.map((_, index) => {
                if (!lateSequenceStarted) return Number(index === activeStep);
                return [
                    0,
                    0,
                    processorOpacity,
                    batcherOpacity,
                    batchProcessorOpacity,
                ][index];
            });
            this.steps?.forEach((step, index) => {
                const opacity = targetOpacities[index] ?? 0;
                const interactive = opacity >= 0.99;
                const copy = step.querySelector<HTMLElement>(".bvx-copy");
                step.classList.toggle("is-active", index === activeStep);
                step.classList.toggle("is-interactive", interactive);
                copy?.setAttribute(
                    "aria-hidden",
                    String(opacity < 0.01),
                );
                copy?.toggleAttribute("inert", !interactive);
            });

            if (this.status) {
                if (batchProcessorTransition >= 0.55)
                    this.status.textContent = "batch processors";
                else if (batcherTransition >= 0.55)
                    this.status.textContent = "batchers";
                else
                    this.status.textContent = [
                        "source",
                        "producers",
                        "processors",
                    ][Math.min(activeStep, 2)];
            }
        }

        renderWire(wire: SVGGElement, active: boolean, progress: number) {
            wire.style.opacity = String(active ? this.clamp(progress) : 0);
        }

        measureWires() {
            const svg = this.querySelector<SVGSVGElement>("[data-wires]");
            if (!svg || !this.sourceNode) return;
            const svgRect = svg.getBoundingClientRect();
            if (!svgRect.width || !svgRect.height) return;
            svg.setAttribute(
                "viewBox",
                `0 0 ${svgRect.width} ${svgRect.height}`,
            );

            const source = this.anchor(this.sourceNode, "right", svgRect);
            this.sourceWires.forEach((wire, index) => {
                const target = this.producerNodes[index];
                if (!target || index >= this.producerCount) return;
                this.setWirePath(
                    wire,
                    this.curve(source, this.anchor(target, "left", svgRect)),
                );
            });

            this.processorWires.forEach((wire) => {
                const index = Number(wire.dataset.processorWire);
                const producerIndex = Number(wire.dataset.producerIndex);
                const target = this.processorNodes[index];
                const origin = this.producerNodes[producerIndex];
                if (!target || !origin || index >= this.processorCount || producerIndex >= this.producerCount) return;
                this.setWirePath(
                    wire,
                    this.curve(
                        this.anchor(origin, "right", svgRect),
                        this.anchor(target, "left", svgRect),
                    ),
                );
            });

            this.batcherWires.forEach((wire) => {
                const index = Number(wire.dataset.batcherWire);
                const origin = this.processorNodes[index];
                const target =
                    this.batcherNodes[Number(wire.dataset.batcherIndex)];
                if (!origin || !target || index >= this.processorCount) return;
                this.setWirePath(
                    wire,
                    this.curve(
                        this.anchor(origin, "right", svgRect),
                        this.anchor(target, "left", svgRect),
                    ),
                );
            });

            this.batchProcessorWires.forEach((wire) => {
                const batcherIndex = Number(wire.dataset.batcherIndex);
                const workerIndex = Number(wire.dataset.workerIndex);
                const origin = this.batcherNodes[batcherIndex];
                const target = this.batchProcessorNodes.find(
                    (node) =>
                        Number(node.dataset.batcherIndex) === batcherIndex &&
                        Number(node.dataset.workerIndex) === workerIndex,
                );
                if (
                    !origin ||
                    !target ||
                    batcherIndex >= this.batcherKeyCount ||
                    workerIndex >= this.batchProcessorCount
                )
                    return;
                this.setWirePath(
                    wire,
                    this.curve(
                        this.anchor(origin, "right", svgRect),
                        this.anchor(target, "left", svgRect),
                    ),
                );
            });
        }

        anchor(element: HTMLElement, side: "left" | "right", frame: DOMRect) {
            const rect = element.getBoundingClientRect();
            if (this.dataset.static === "true") return {
                x: rect.left + rect.width / 2 - frame.left,
                y: (side === "left" ? rect.top : rect.bottom) - frame.top,
            };
            return {
                x: (side === "left" ? rect.left : rect.right) - frame.left,
                y: rect.top + rect.height / 2 - frame.top,
            };
        }

        curve(start: { x: number; y: number }, end: { x: number; y: number }) {
            if (this.dataset.static === "true") {
                const bend = Math.max(16, (end.y - start.y) * 0.48);
                return `M ${start.x} ${start.y} C ${start.x} ${start.y + bend}, ${end.x} ${end.y - bend}, ${end.x} ${end.y}`;
            }
            const bend = Math.max(32, (end.x - start.x) * 0.48);
            return `M ${start.x} ${start.y} C ${start.x + bend} ${start.y}, ${end.x - bend} ${end.y}, ${end.x} ${end.y}`;
        }

        setWirePath(wire: SVGGElement, path: string) {
            const base = wire.querySelector<SVGPathElement>(".bvx-wire-base");
            base?.setAttribute("d", path);
        }

        clamp(value: number) {
            return Math.max(0, Math.min(1, value));
        }
    }

    if (!customElements.get("broadway-scroll-explainer")) {
        customElements.define(
            "broadway-scroll-explainer",
            BroadwayScrollExplainer,
        );
    }
</script>


---
import type { ImageMetadata } from "astro";
import JsonLd from "../components/JsonLd.astro";
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "../config";

type Props = {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  coverImage?: string | ImageMetadata;
  math?: boolean;
  tags?: string[];
};

const { title, description, date, updated, coverImage, math, tags = [] } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const formattedDate = dateFormatter.format(date);
const formattedUpdated = updated ? dateFormatter.format(updated) : null;

const coverImageHref = typeof coverImage === "string" ? coverImage : coverImage?.src;
const absoluteCover = coverImageHref
  ? new URL(coverImageHref, siteConfig.baseUrl).toString()
  : undefined;

const canonical = new URL(Astro.url.pathname, siteConfig.baseUrl).toString();
const articleData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  url: canonical,
  headline: title,
  description,
  image: absoluteCover ?? new URL(siteConfig.defaultCoverImage, siteConfig.baseUrl).toString(),
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: "en",
  keywords: tags.length > 0 ? tags : undefined,
  author: { "@id": `${siteConfig.baseUrl}/#person` },
  publisher: { "@id": `${siteConfig.baseUrl}/#person` },
  isPartOf: { "@id": `${siteConfig.baseUrl}/posts/#blog` },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  coverImageUrl={absoluteCover}
  ogType="article"
  publishedDate={date}
  math={math}
>
  <JsonLd data={articleData} slot="json-ld" />

  <div id="main" role="main" class="container post-page">
    <article class="post">
      <h1>{title}</h1>

      <time class="post-meta-top" datetime={date.toISOString()}>
        {formattedDate}
        {formattedUpdated && ` · Updated ${formattedUpdated}`}
      </time>

      <div class="entry">
        <slot />
      </div>

      <time class="posted-at" datetime={date.toISOString()}>
        Written on {formattedDate}
        {formattedUpdated && ` · Last updated on ${formattedUpdated}`}
      </time>
    </article>
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { siteConfig } from "../../config";
import { getSortedPosts, postUrl } from "../../lib/posts";

const posts = await getSortedPosts();

function truncate(text: string, max: number): string {
  const stripped = text.replace(/<[^>]*>/g, "");
  return stripped.length > max ? stripped.slice(0, max).trimEnd() + "…" : stripped;
}

function ym(date: Date): string {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
}

const blogId = `${siteConfig.baseUrl}/posts/#blog`;
const blogData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": blogId,
  url: `${siteConfig.baseUrl}/posts/`,
  name: "Posts by Andrea Leopardi",
  description: "Writings by Andrea Leopardi on Elixir, systems, and software.",
  inLanguage: "en",
  isPartOf: { "@id": `${siteConfig.baseUrl}/#website` },
  author: { "@id": `${siteConfig.baseUrl}/#person` },
  publisher: { "@id": `${siteConfig.baseUrl}/#person` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": `${siteConfig.baseUrl}${postUrl(post)}#article`,
    url: `${siteConfig.baseUrl}${postUrl(post)}`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    author: { "@id": `${siteConfig.baseUrl}/#person` },
    isPartOf: { "@id": blogId },
  })),
};
---

<BaseLayout title="Posts" description="Writings by Andrea Leopardi on Elixir, systems, and software.">
  <JsonLd data={blogData} slot="json-ld" />

  <main id="main" role="main" class="container posts-page">
    <section class="posts-index-dense" aria-labelledby="posts-heading">
      <div class="shell-section-header">
        <h1 id="posts-heading" class="shell-section-label posts-index-label">posts</h1>
        <span class="shell-section-rule"></span>
        <span class="posts-index-count">{posts.length} entries</span>
      </div>

      {posts.map((post) => (
        <a href={postUrl(post)} class="shell-post">
          <span class="shell-post-prompt" aria-hidden="true">&gt;</span>
          <span class="shell-post-body">
            <strong>{post.data.title}</strong>
            {post.data.description && (
              <span class="shell-post-desc">{truncate(post.data.description, 90)}</span>
            )}
          </span>
          <time class="shell-post-date" datetime={post.data.date.toISOString()}>
            {ym(post.data.date)}
          </time>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
